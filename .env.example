# Copy this file to `.env` and fill in the values. `.env` is gitignored — never commit it.
#
# TWO DIFFERENT MECHANISMS READ THIS FILE, and which one applies depends on the prefix.
#
# electron-vite inlines prefixed variables into a bundle at BUILD time (import.meta.env):
#   MAIN_VITE_*      → main process
#   PRELOAD_VITE_*   → preload bridge
#   RENDERER_VITE_*  → renderer / UI
#
# Everything else is loaded into `process.env` at STARTUP by `src/main/env.ts`, main process
# only, and never reaches a bundle. electron-vite does not do this — it reads the three
# prefixes above and nothing else — so an unprefixed variable used to be documented here and
# silently never delivered (Bug #297). Two consequences worth knowing:
#
#   * A REAL ENVIRONMENT VARIABLE WINS over this file. Setting one in your shell or OS
#     overrides the value here without editing anything.
#   * A PACKAGED BUILD HAS NO `.env` beside its binary, so there an unprefixed variable must
#     come from the operating system.
#
# Changing an unprefixed value needs an app restart: it is read at startup, and there is no
# hot reload across the main-process boundary.

# Mapbox GL JS public access token (starts with `pk.`). Used by the renderer's map view.
# Create one at https://account.mapbox.com/access-tokens/
RENDERER_VITE_MAPBOX_TOKEN=

# Interactive Brokers Client Portal Gateway. Defaults to https://localhost:5000 when unset.
# IBKR_GATEWAY_URL=https://localhost:5000
# IBKR_ACCOUNT_ID=

# Bounded wait for every gateway request, in milliseconds. Defaults to 15000 when unset or
# nonsensical — the bound cannot be disabled, only retuned (Story #104).
# IBKR_GATEWAY_TIMEOUT_MS=15000

# OpenAI API key for the AI assistant (Epic #5). Starts with `sk-`.
# Create one at https://platform.openai.com/api-keys
#
# DELIBERATELY UNPREFIXED — it is loaded into `process.env` at startup, main process only,
# and never enters a bundle. A `RENDERER_VITE_` prefix would inline the secret into the
# shipped renderer bundle, and the renderer may not reach the network for this anyway (the
# CSP admits only api.mapbox.com). Every model call is made from main, behind an IPC channel.
#
# Leaving this empty is a supported state: the assistant reports "not configured" rather
# than failing — the same shape as the gateway's `not_connected` (DDR-0022).
#
# THERE IS ALSO A FIELD FOR THIS INSIDE THE APP, on the Assistant view (Story #300, DDR-0105).
# That one is stored in the app's own database and is how a PACKAGED build gets a key, since
# there is no `.env` beside an installed binary. Precedence: this variable — or a real OS
# variable, which wins over this file — beats a key saved in the app. Both are unencrypted;
# the app says so where it asks. Set one here and the app tells you the saved one is stored
# and not in use, rather than silently picking.
OPENAI_API_KEY=

# Model used by the assistant. Defaults to gpt-4.1-mini when unset.
# OPENAI_MODEL=gpt-4.1-mini

# Bounded wait for every model request, in milliseconds. Defaults to 60000 when unset or
# nonsensical. Longer than the gateway's bound: a completion is slower than a quote.
# OPENAI_TIMEOUT_MS=60000

# Bounded wait for a whole question, in milliseconds, however many rounds it takes. Defaults to
# 180000. A second deadline rather than a bigger one: the request bound above stops a socket that
# has gone quiet, and cannot bound a question that makes several requests. How many rounds a
# question may take is NOT configurable — see MAX_TOOL_ROUNDS in aiGateway.ts.
# OPENAI_QUESTION_TIMEOUT_MS=180000
