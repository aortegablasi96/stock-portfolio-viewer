# Dependencies
node_modules/

# Build output
dist/
out/
release/
.vite/

# `build/` is electron-builder's buildResources directory (see electron-builder.yml), so
# despite the name it holds *source* — the icon stamped onto the executable, the installer
# and the taskbar entry, plus the dependency-free script that draws it. It was ignored
# wholesale here, under the heading above, which is why the app shipped with Electron's
# default icon. Ignore anything else that lands there; keep the two sources.
build/*
!build/icon.ico
!build/icon.mjs

# electron-vite writes a timestamped copy of its config beside the original while it
# loads it, and does not always clean it up if the build is interrupted.
electron.vite.config.*.mjs

# Electron packaged artifacts
*.exe
*.dmg
*.AppImage
*.snap

# Environment / secrets
.env
.env.*
!.env.example

# Personal IBKR Flex Query exports (real account data — kept local, never committed).
# The parser is tested against a compact inline fixture; the real-file test skips when absent.
docs/flex-queries/

# The Figma Make export Epic #179 adopts the design of. A local working copy of a proposal
# whose source of truth is the Figma file; every M5 story states its own values rather than
# pointing here, so the folder can go at any time without making an issue unreadable.
docs/figma_design/

# Local SQLite database files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs
logs/
*.log
npm-debug.log*

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test / coverage output
coverage/
playwright-report/
test-results/
